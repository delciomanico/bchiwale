# Formulário de contacto (Web3Forms). Em Docker/Dokploy use a variável do CONTAINER WEB3FORMS_KEY (lida no arranque).
VITE_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dynamix-CMS (fonte do conteúdo do site) — URL pública da API e slug do projeto.
# Em dev o defeito é http://localhost:3001/api/v1 (não precisa de definir nada).
# Em produção (Docker/Dokploy) use as variáveis do CONTAINER DYNAMIX_API_URL / DYNAMIX_PROJECT (lidas no arranque);
# as VITE_* abaixo (fixadas no build) servem para Vercel/outros.
VITE_DYNAMIX_API_URL=https://cms.exemplo.com/api/v1
VITE_DYNAMIX_PROJECT=bchiwale

# (LEGADO — só usado pelo backend/admin antigo em api/) CMS — pulled automatically via `vercel env pull .env.local` once Postgres + Blob
# are provisioned on the Vercel project (Storage tab in the dashboard).
POSTGRES_URL=postgres://user:password@host/db?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# CMS admin login — set these in Vercel Project Settings > Environment Variables.
# Generate the hash locally with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=replace-with-a-long-random-string

